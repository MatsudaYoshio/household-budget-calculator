#!/bin/sh
#
# Pre-commit hook that runs dotnet format on staged C# files only
#

# Get list of staged C# files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.cs' '*.csproj' '*.sln')

if [ -z "$STAGED_FILES" ]; then
    echo "No C# files staged for commit."
    exit 0
fi

echo "Running dotnet format on staged files..."

# Create a temporary list of staged files
TEMP_FILE=$(mktemp "${TMPDIR:-/tmp}/git-hook.XXXXXX")
echo "$STAGED_FILES" > "$TEMP_FILE"

# Run dotnet format on the staged files
if command -v dotnet >/dev/null 2>&1; then
    # Format only the staged files
    while IFS= read -r file; do
        if [ -f "$file" ]; then
            echo "Formatting: $file"
            dotnet format --include "$file" --verbosity minimal
        fi
    done < "$TEMP_FILE"
    
    # Clean up
    rm "$TEMP_FILE"
    
    # Re-stage the formatted files
    echo "$STAGED_FILES" | xargs git add
    
    echo "Code formatting completed."
else
    echo "Warning: dotnet CLI not found. Skipping format check."
    rm "$TEMP_FILE"
    exit 0
fi

exit 0