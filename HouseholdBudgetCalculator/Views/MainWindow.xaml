<Window x:Class="HouseholdBudgetCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HouseholdBudgetCalculator"
        mc:Ignorable="d"
        Title="HouseholdBudgetCalculator" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="10">
            <Button Content="Load CSV" Command="{Binding LoadCsvFileCommand}" Margin="5,0"/>
            <Button Content="Show Summary" Command="{Binding ShowCategorySummaryWindowCommand}" Margin="5,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding CsvDataList}" AutoGenerateColumns="False" Margin="10" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="利用日/キャンセル日" Binding="{Binding DateOfUse, StringFormat='yyyy/M/d'}" />
                <DataGridTextColumn Header="利用店名・商品名" Binding="{Binding ProductName}" />
                <DataGridTextColumn Header="支払総額" Binding="{Binding TotalPaymentAmount}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
